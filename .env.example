# docker-compose.yml variables (roadmap 7.3). Copy to .env (git-ignored) and
# set the secrets; everything else has a local default. Docker Compose 2.24.4
# or newer (docs/DEPLOYMENT.md, "Requirements").
#
#   cp .env.example .env
#   sed -i "s/^JWT_SECRET=.*/JWT_SECRET=$(openssl rand -hex 32)/; s/^NEXTAUTH_SECRET=.*/NEXTAUTH_SECRET=$(openssl rand -hex 32)/; s/^GRAFANA_ADMIN_PASSWORD=.*/GRAFANA_ADMIN_PASSWORD=$(openssl rand -hex 24)/" .env
#   docker compose up --build -d --wait
#
# The API refuses to boot in production with a secret under 32 characters or
# one that still looks like a template value.
JWT_SECRET=
NEXTAUTH_SECRET=

# Where the browser reaches the two servers: WEB_ORIGIN is the CORS origin
# and NextAuth URL; API_PUBLIC_URL is the API as the browser reaches it, read
# by the web server at RUN time (one image serves every environment; behind
# the edge it is https://<API_HOST>/api). NEXT_PUBLIC_API_URL is not a
# setting here: it is only the web image's build-time fallback.
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3002/api
# The marketing site's canonical address (sitemap.xml, robots.txt, Open Graph,
# llms.txt), read by the web server at run time. Blank = WEB_ORIGIN.
SITE_URL=
# false keeps search engines out (set it on staging): noindex pages,
# robots.txt Disallow: /, no sitemap or llms.txt. Blank = true.
SITE_INDEXABLE=
WEB_PORT=3000
API_PORT=3002

# MySQL 8 (the `migrate` service applies the migrations as this user).
MYSQL_DATABASE=dukaanai
MYSQL_USER=dukaanai
MYSQL_PASSWORD=dukaanai-local-only
MYSQL_ROOT_PASSWORD=root-local-only
API_DB_CONNECTION_LIMIT=20

# Observability (roadmap 7.6): the log level (production prints at most "log"),
# the bearer token for GET /api/metrics (the API runs as production, where the
# route answers 404 while METRICS_TOKEN is blank, audit R13: set it before
# `--profile ops`, e.g. `openssl rand -hex 24`; docker-compose.prod.yml refuses
# to start without it), the Sentry DSN (blank = off)
# and the release label the images built here carry (a build argument: GET
# /api/health, build_info and tracked errors report it; release images from
# the registry carry their version tag, roadmap 9.21).
# `docker compose --profile ops up -d prometheus` scrapes the API with
# deploy/prometheus/prometheus.yml (sending METRICS_TOKEN as its bearer
# token) and loads deploy/prometheus/alerts.yml with the backup kinds of the
# topology. PROMETHEUS_PUBLIC_API_URL / PROMETHEUS_PUBLIC_WEB_URL add probes
# of the public addresses through the edge (the production file defaults
# them to API_PUBLIC_URL and WEB_ORIGIN; blank here = the inner probes only).
LOG_LEVEL=log
METRICS_TOKEN=
SENTRY_DSN=
APP_RELEASE=
PROMETHEUS_PUBLIC_API_URL=
PROMETHEUS_PUBLIC_WEB_URL=

# Backups (roadmap 7.7, 9.2, 9.3, 9.4; `docker compose --profile ops`):
# how many dumps and documents archives to keep, how long the binary-log
# archive keeps logs and how often the binlog-archiver service runs, and the
# off-site target: an rclone path (s3:bucket/dukaanai, b2:bucket/dukaanai,
# r2:bucket/dukaanai; the backend's credentials are RCLONE_CONFIG_<NAME>_*
# variables, see docs/BACKUP_RESTORE.md) plus the encryption key (32+
# characters; losing it loses every off-site copy: keep it in the secret
# store, never only here). Blank = `db-ops offsite` refuses with the reason.
BACKUP_KEEP=14
DOCUMENTS_BACKUP_KEEP=14
BINLOG_ARCHIVE_KEEP_DAYS=7
BINLOG_ARCHIVE_INTERVAL_SECONDS=300
OFFSITE_REMOTE=
OFFSITE_CRYPT_PASSWORD=
OFFSITE_CRYPT_SALT=
OFFSITE_KEEP_DAYS=30

# The edge (roadmap 9.8; `docker compose --profile edge up -d edge`, always on
# in docker-compose.prod.yml): the public hostnames Caddy serves and how it
# gets certificates. Blank EDGE_TLS_LINE = automatic public certificates
# (real DNS names, ports 80/443 reachable from the internet); "tls internal"
# = Caddy's own CA for local work and the smoke. With the edge in front set
# WEB_ORIGIN=https://<WEB_HOST> and API_PUBLIC_URL=https://<API_HOST>/api.
WEB_HOST=app.localhost
API_HOST=api.localhost
EDGE_TLS_LINE=tls internal
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
EDGE_MAX_BODY=64MB
EDGE_UPSTREAM_TIMEOUT=60s
# Addresses or CIDR ranges the edge refuses with 403, space-separated (a
# credential flood, docs/RUNBOOKS.md); 0.0.0.0/32 matches no client.
EDGE_BLOCKED_IPS=0.0.0.0/32

# Production variant only (docker-compose.prod.yml, roadmap 9.7): the managed
# database over TLS (`?sslaccept=strict`; add `&sslcert=/etc/dukaanai/db-ca.pem`
# and set DB_CA_FILE to the provider's CA file when it is not signed by a
# public CA), managed Redis (rediss:// for TLS), the cloud disk the documents
# live on (absolute paths; blank = named volumes), the proxy hop count and
# the backup agent (a backup user with RELOAD + REPLICATION CLIENT, or the
# application user with BACKUP_COORDINATES=skip).
DATABASE_URL=
DB_CA_FILE=
REDIS_URL=
STORAGE_PATH=
UPLOADS_PATH=
BACKUPS_PATH=
TRUST_PROXY=1
DB_OPS_DATABASE_URL=
BACKUP_COORDINATES=auto
BACKUP_LOOP_INTERVAL_SECONDS=86400
BACKUP_LOOP_INITIAL_DELAY_SECONDS=60

# Azure target (deploy/azure): the production file with the
# deploy/azure/compose.yml overlay on one Arm64 VM, Azure Database for MySQL
# Flexible Server over verified TLS, Redis 7 on the VM, deployed by
# `deploy/azure/stack.sh up` (deploy/azure/bootstrap.sh writes this file as
# /etc/dukaanai/dukaanai.env). Set on that target:
#   AZURE_MYSQL_HOST (<server>.mysql.database.azure.com) and the server
#     admin AZURE_MYSQL_ADMIN_USER / AZURE_MYSQL_ADMIN_PASSWORD: used only
#     by db-init, which creates the two users the stack runs as
#   MYSQL_PASSWORD, MYSQL_BACKUP_PASSWORD, REDIS_PASSWORD: `openssl rand -hex 32`
#   DATABASE_URL=mysql://dukaanai:<MYSQL_PASSWORD>@<AZURE_MYSQL_HOST>:3306/dukaanai?connection_limit=20&sslaccept=strict&sslcert=/etc/dukaanai/db-ca.pem
#   DB_OPS_DATABASE_URL=mysql://dukaanai_backup:<MYSQL_BACKUP_PASSWORD>@<AZURE_MYSQL_HOST>:3306/dukaanai?sslaccept=strict&sslcert=/etc/dukaanai/db-ca.pem
#   DB_CA_FILE=/etc/dukaanai/db-ca.pem (a copy of deploy/azure/azure-mysql-ca.pem)
#   REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
#   OFFSITE_REMOTE=b2:<bucket>/dukaanai with the B2 application key (read,
#     write, delete on that bucket only) through B2's S3 API below: the
#     keyID as ACCESS_KEY_ID, the key as SECRET_ACCESS_KEY, the bucket's
#     region in ENDPOINT (https://s3.<region>.backblazeb2.com) and REGION
# The backup agent dumps hourly (BACKUP_LOOP_HOURLY_SECONDS, keep
# BACKUP_HOURLY_KEEP; off-site for OFFSITE_HOURLY_KEEP_DAYS) besides the
# nightly set. Never set COMPOSE_PROFILES=ops there: the monitoring stack
# does not fit the VM.
AZURE_MYSQL_HOST=
AZURE_MYSQL_ADMIN_USER=
AZURE_MYSQL_ADMIN_PASSWORD=
MYSQL_BACKUP_PASSWORD=
REDIS_PASSWORD=
BACKUP_LOOP_HOURLY_SECONDS=3600
BACKUP_HOURLY_KEEP=48
OFFSITE_HOURLY_KEEP_DAYS=3
RCLONE_CONFIG_B2_TYPE=s3
RCLONE_CONFIG_B2_PROVIDER=Other
RCLONE_CONFIG_B2_ENDPOINT=
RCLONE_CONFIG_B2_REGION=
RCLONE_CONFIG_B2_NO_CHECK_BUCKET=true
RCLONE_CONFIG_B2_ACCESS_KEY_ID=
RCLONE_CONFIG_B2_SECRET_ACCESS_KEY=

# Releases (roadmap 9.9; docker-compose.prod.yml only): the registry the
# release workflow pushes to and the tag to run. Staging and production run
# the same tag (sha-<commit> from every main build, v<version> from a tag);
# nothing is built on a server. docker-compose.build.yml builds from a
# checkout instead (the smoke, local work: IMAGE_REGISTRY=local IMAGE_TAG=dev).
IMAGE_REGISTRY=ghcr.io/shoryabansalgithub
IMAGE_TAG=

# Alert delivery (roadmap 9.10; `docker compose --profile ops up -d alertmanager`,
# deploy/alertmanager): critical alerts page the on-call (PagerDuty when the
# key is set, else Slack + email at once); warnings go to the team and wait
# for the working day (22:00-08:00 and Sunday in ALERT_TIMEZONE). Blank =
# that channel is off; with all three blank nothing is delivered and the
# service says so at start. Grafana (port 3001) and its admin password:
# docker-compose.prod.yml refuses to start without one (no admin/admin), the
# reference stack falls back to "admin" when the line is removed. Every
# monitoring port is published on 127.0.0.1 only (Docker's published ports
# bypass ufw / firewalld): reach them through an SSH tunnel. *_BIND
# (PROMETHEUS_BIND, ALERTMANAGER_BIND, BLACKBOX_BIND, LOKI_BIND, GRAFANA_BIND)
# moves one to another address of the host, never 0.0.0.0 on a public host.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=alerts@dukaanai.local
ALERT_SMTP_SMARTHOST=
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_REQUIRE_TLS=true
ALERT_SLACK_WEBHOOK_URL=
ALERT_SLACK_CHANNEL=#ops-alerts
ALERT_PAGERDUTY_ROUTING_KEY=
ALERT_TIMEZONE=Asia/Kolkata
ALERTMANAGER_EXTERNAL_URL=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=___REPLACE_ME_GRAFANA_ADMIN_PASSWORD___
GRAFANA_ROOT_URL=http://localhost:3001

# Optional integrations (blank = feature off; invitations need SMTP in production).
SMTP_URL=
EMAIL_FROM=DukaanAI <no-reply@dukaanai.local>
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
