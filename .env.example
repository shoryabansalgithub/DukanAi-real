# docker-compose.yml variables (roadmap 7.3). Copy to .env (git-ignored) and
# set the two secrets; everything else has a local default.
#
#   cp .env.example .env
#   sed -i "s/^JWT_SECRET=.*/JWT_SECRET=$(openssl rand -hex 32)/; s/^NEXTAUTH_SECRET=.*/NEXTAUTH_SECRET=$(openssl rand -hex 32)/" .env
#   docker compose up --build -d --wait
#
# The API refuses to boot in production with a secret under 32 characters or
# one that still looks like a template value.
JWT_SECRET=
NEXTAUTH_SECRET=

# Where the browser reaches the two servers (CORS origin, NextAuth URL, the
# API URL inlined into the web bundle at build time).
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3002/api
WEB_PORT=3000
API_PORT=3002

# MySQL 8 (the `migrate` service applies the migrations as this user).
MYSQL_DATABASE=dukaanai
MYSQL_USER=dukaanai
MYSQL_PASSWORD=dukaanai-local-only
MYSQL_ROOT_PASSWORD=root-local-only
API_DB_CONNECTION_LIMIT=20

# Observability (roadmap 7.6): the log level (production prints at most "log"),
# an optional bearer token for GET /api/metrics, the Sentry DSN (blank = off)
# and the release label stamped on tracked errors.
# `docker compose --profile ops up -d prometheus` scrapes the API with
# deploy/prometheus/prometheus.yml and loads deploy/prometheus/alerts.yml.
LOG_LEVEL=log
METRICS_TOKEN=
SENTRY_DSN=
APP_RELEASE=

# Optional integrations (blank = feature off; invitations need SMTP in production).
SMTP_URL=
EMAIL_FROM=DukaanAI <no-reply@dukaanai.local>
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
