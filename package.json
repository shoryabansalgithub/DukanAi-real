{
  "name": "dukaanai",
  "version": "0.1.0",
  "description": "DukaanAI - AI-Powered Retail Operating System",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "^10.0.13"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "@nestjs/swagger": {
      "js-yaml": "^5.4.2"
    },
    "postcss": "^8.5.28"
  }
}
