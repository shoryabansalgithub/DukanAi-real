{
  "name": "dukaanai",
  "version": "1.0.0-rc3",
  "description": "DukaanAI - AI-Powered Retail Operating System",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "start:all": "run-all.bat",
    "stop:all": "stop-all.bat",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "eslint": "^9.39.5",
    "prettier": "^3.1.0",
    "turbo": "^2.11.7",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "^10.2.1"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "@nestjs/platform-express": {
      "multer": "^2.5.0"
    },
    "@nestjs/swagger": {
      "js-yaml": "^5.4.2"
    },
    "postcss": "^8.5.28"
  },
  "dependencies": {
    "cross-env": "^10.1.0"
  }
}
