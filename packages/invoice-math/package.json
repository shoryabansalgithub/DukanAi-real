{
  "name": "@dukaanai/invoice-math",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12"
  },
  "description": "Shared mathematical engine for DukaanAI billing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"for (const d of process.argv.slice(1)) require('fs').rmSync(d, { recursive: true, force: true })\" dist"
  },
  "dependencies": {
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.3.3"
  }
}
