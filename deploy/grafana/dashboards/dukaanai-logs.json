{
  "uid": "dukaanai-logs",
  "title": "DukaanAI logs",
  "tags": [
    "dukaanai"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "",
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Lines carrying the correlation id (every service)",
      "description": "Type the x-correlation-id a client quoted (every API answer echoes it). The API logs one access line per request and every error with it; the web and the edge lines of the same request appear when they carry it.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{project=~\"$project\"} |~ \"$correlationId\""
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "API lines for the correlation id, parsed",
      "description": "The API's JSON lines (Nest json logger: message.correlationId): the access line (event=http: method, route, status, ms) and every log of the request.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{project=~\"$project\", service=\"api\"} |~ \"$correlationId\" | json | message_correlationId=\"$correlationId\""
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "API errors (last range)",
      "description": "Unhandled exceptions and Prisma errors, each with its correlation id",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{project=~\"$project\", service=\"api\"} | json | level=\"error\""
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API lines per minute by level",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (count_over_time({project=~\"$project\", service=\"api\"} | json | __error__=\"\" [1m]))",
          "legendFormat": "{{level}}"
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "correlationId",
        "label": "Correlation id",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      },
      {
        "type": "query",
        "name": "project",
        "label": "Compose project",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "project",
          "type": 1
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      }
    ]
  }
}