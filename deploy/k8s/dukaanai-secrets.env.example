# Copy to dukaanai-secrets.env (never committed; deploy/k8s/.gitignore) and fill in.
# The kustomization turns it into the `dukaanai-secrets` Secret; a change
# makes a new hashed name and rolls the deployments.
#
# Managed MySQL 8 over TLS. `sslaccept=strict` verifies the server
# certificate; a provider whose CA is not in the system trust store also
# needs `&sslcert=/etc/dukaanai/db-ca.pem` here and the CA in the optional
# `dukaanai-db-ca` Secret (README.md).
DATABASE_URL=mysql://dukaanai:CHANGE_ME@mysql.internal:3306/dukaanai?connection_limit=20&sslaccept=strict
# The backup sidecar: a backup user with RELOAD + REPLICATION CLIENT (the
# dump records its binary-log position), or the application URL with
# BACKUP_COORDINATES=skip in the ConfigMap.
DB_OPS_DATABASE_URL=mysql://dukaanai_backup:CHANGE_ME@mysql.internal:3306/dukaanai
# Managed Redis; rediss:// for TLS, the path is the db index.
REDIS_URL=rediss://:CHANGE_ME@redis.internal:6379/0
# 32+ characters each: openssl rand -hex 32
JWT_SECRET=CHANGE_ME________________________________________________________
NEXTAUTH_SECRET=CHANGE_ME________________________________________________________
# Optional integrations (blank = off; invitations need SMTP in production).
SMTP_URL=
GEMINI_API_KEY=
METRICS_TOKEN=
SENTRY_DSN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypted off-site copies (docs/BACKUP_RESTORE.md): the rclone remote
# name, its backend as RCLONE_CONFIG_<NAME>_* and the crypt password.
OFFSITE_REMOTE=
OFFSITE_CRYPT_PASSWORD=
OFFSITE_CRYPT_SALT=
