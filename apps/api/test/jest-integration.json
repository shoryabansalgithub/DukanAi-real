{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".integration-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": [
    "<rootDir>/test/jest-integration.setup.ts"
  ],
  "testTimeout": 120000,
  "maxWorkers": 1,
  "moduleNameMapper": {
    "^archiver$": "<rootDir>/test/stubs/archiver.stub.js"
  },
  "forceExit": true
}
