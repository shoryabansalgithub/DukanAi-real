{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "\\.(integration|security)-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": [
    "<rootDir>/test/jest-integration.setup.ts"
  ],
  "testTimeout": 120000,
  "maxWorkers": 1,
  "forceExit": true,
  "globalSetup": "<rootDir>/test/jest-integration.global-setup.ts"
}
