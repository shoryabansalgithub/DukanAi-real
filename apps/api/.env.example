################################################################################
# DUKAN AI ENTERPRISE ENVIRONMENT FILE
#
# Every variable the API reads is listed here with its default (roadmap 8.5;
# src/config/env-example.spec.ts fails when one is missing or when a template
# carries a variable nothing reads). Numeric values are hydrated by
# src/config/hydrate-from-env.ts: blank keeps the default, 0 is a value, and
# anything that is not a number refuses to boot.
################################################################################

################################################################################
# APPLICATION
################################################################################
# Required: development, test or production. The start scripts set it; a
# process without it refuses to boot rather than run as development.
NODE_ENV=development
PORT=3002
FRONTEND_URL=http://localhost:3000
# Reverse proxies between the internet and the API (Express "trust proxy").
# false (default) trusts nothing: the socket address is the client and
# X-Forwarded-For is ignored. Set the number of proxy hops (e.g. 1 for one
# nginx / load balancer), or "loopback", "linklocal", "uniquelocal", or a
# comma-separated list of IPs / CIDR ranges. "true" trusts every hop and lets
# any client spoof its address: never use it in production. The web app is a
# proxy too: it forwards the browser's address on sign-in and refresh calls,
# so count it as a hop when it and the API share a host.
TRUST_PROXY=false

# Deployment (roadmap 7.3). On SIGTERM the readiness probe (GET /api/health/ready)
# answers 503 at once, the process waits SHUTDOWN_DRAIN_DELAY_MS for the load
# balancer to stop routing to it (0 under compose, a few seconds behind a
# Kubernetes Service), then stops listening, finishes in-flight requests and
# active jobs and closes BullMQ, Redis and Prisma. A drain still running after
# SHUTDOWN_TIMEOUT_MS exits 1; keep the orchestrator's grace period above the
# sum of the two. HTTP_KEEP_ALIVE_TIMEOUT_MS must exceed the idle timeout of
# the proxy in front (60 s on most) or it answers 502 on a reused connection.
# QUEUE_READY_TIMEOUT_MS bounds how long boot waits for the BullMQ connections
# before it listens anyway.
SHUTDOWN_TIMEOUT_MS=30000
SHUTDOWN_DRAIN_DELAY_MS=0
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
QUEUE_READY_TIMEOUT_MS=30000

################################################################################
# DATABASE
################################################################################
# MySQL 8 connection string; add ?connection_limit= per instance.
DATABASE_URL=mysql://root:password@localhost:3306/dukaanai
# Print every SQL statement (development only; production never logs queries).
PRISMA_LOG_QUERIES=true

################################################################################
# REDIS, QUEUES AND CACHE
################################################################################
# redis:// or rediss:// (TLS); the path is the database index. Dev uses db 0,
# the tests db 1 on the same server (see TEST_REDIS_URL in .env.test).
REDIS_URL=redis://localhost:6379
# The shared ioredis client (locks, throttling, stock hints): TCP connect
# budget, per-command reply budget, and ioredis retries per command while
# reconnecting (BullMQ builds its own connection and always uses null there).
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=2000
REDIS_MAX_RETRIES_PER_REQUEST=1

# Default BullMQ job options for every queue: attempts per job, backoff
# between attempts (exponential or fixed, starting at BULL_BACKOFF_DELAY ms),
# and whether finished / failed jobs are removed from Redis. Booleans accept
# true/false spellings only.
BULL_ATTEMPTS=3
BULL_BACKOFF_TYPE=exponential
BULL_BACKOFF_DELAY=1000
BULL_REMOVE_ON_COMPLETE=true
BULL_REMOVE_ON_FAIL=false

# Cache (cache-manager on a Keyv Redis store, keys cache:<key>, shared by every
# instance; an in-process Map without REDIS_URL). CACHE_TTL is the default
# entry lifetime; the rest are per-feature lifetimes for cached reads. All in
# milliseconds except the two *_SECONDS keys. 0 disables that cache.
CACHE_TTL=3600000
CACHE_VENDOR_BILL_TTL_MS=60000
CACHE_SUPPLIER_CREDIT_TTL_MS=60000
CACHE_PURCHASE_RETURN_TTL_MS=60000
CACHE_PURCHASE_TTL_MS=60000
CACHE_GRN_TTL_MS=60000
CACHE_EVENTS_STATS_TTL_MS=60000
CACHE_CUSTOMER_SEARCH_TTL_MS=60000
CACHE_VALIDATION_RULE_ENGINE_TTL_MS=900000
# Dashboard figures: the hour applies to the dashboard payload, the KPI window
# (60 s) to the KPI strip and the all-time totals; every committed sale,
# return and cancellation drops them (roadmap 5.5).
CACHE_ANALYTICS_DASHBOARD_TTL_MS=3600000
CACHE_ANALYTICS_KPI_TTL_MS=60000
CACHE_ANALYTICS_VENDOR_PERF_TTL_MS=900000
CACHE_ANALYTICS_TREND_TTL_MS=3600000
# Redis stock hints (stock:{shopId}:{productId}, advisory only) and drift
# markers, in seconds; product search's stock snapshot, in milliseconds.
CACHE_INVENTORY_STOCK_TTL_SECONDS=3600
CACHE_INVENTORY_DRIFT_TTL_SECONDS=3600
CACHE_SEARCH_STOCK_TTL_MS=30000

# Background schedulers (cron expressions, 5 or 6 fields). CRON_ENABLED=false
# registers none of them; an expression with no upcoming run fails boot.
# Every instance runs every scheduler; a Redis lock keeps each run to one
# instance. The outbox reaper returns stale claims (EVENTS_OUTBOX_STALE_CLAIM_MS)
# to PENDING.
CRON_ENABLED=true
CRON_PURCHASE_OUTBOX_RELAY="* * * * * *"
CRON_EVENTS_OUTBOX_RELAY="*/5 * * * * *"
CRON_PRODUCT_OUTBOX_RELAY="* * * * * *"
CRON_OUTBOX_REAPER="* * * * *"
CRON_INVENTORY_RECON="*/5 * * * *"
CRON_ANALYTICS_JOB="0 0 * * *"
CRON_BATCH_EXPIRY_SWEEP="0 * * * *"
CRON_RESERVATION_EXPIRY_SWEEP="* * * * *"
CRON_RETENTION_SWEEP="30 3 * * *"
# Nightly financial reconciliation of every shop's previous business day (roadmap 9.5).
CRON_RECONCILIATION="30 1 * * *"

################################################################################
# LOGGING & MONITORING (roadmap 7.6)
################################################################################
# Most verbose level printed: fatal, error, warn, log, debug or verbose. Every
# line is one JSON object carrying the request's correlation id. Defaults to
# debug outside production and to log in production, which refuses debug and
# verbose at boot.
LOG_LEVEL=debug
# Prometheus text metrics at GET /api/metrics (no login, exempt from rate
# limiting). Keep the port off the public internet; METRICS_TOKEN (16+
# characters) makes the scrape require "Authorization: Bearer <token>".
METRICS_ENABLED=true
METRICS_TOKEN=
# Error tracking (Sentry): unset = off, nothing is dialled. The DSN comes from
# the Sentry project settings (a placeholder refuses to boot); APP_RELEASE (a
# commit SHA or image tag) and SENTRY_ENVIRONMENT (defaults to NODE_ENV) label
# every event; request bodies, headers and cookies are never sent.
# APP_RELEASE is baked into the release images (the version tag or
# sha-<commit>, roadmap 9.21), shown by GET /api/health and the build_info
# metric; leave it unset here and in compose unless overriding the image's.
# SENTRY_TRACES_SAMPLE_RATE is 0..1 (0 = errors only, no performance traces).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
APP_RELEASE=
# Backup monitoring (roadmap 9.4): the directory where the backup jobs record
# their last success (<kind>.last-success, written by scripts/db/lib.sh:
# dump, binlog, documents, offsite); every scrape turns it into
# backup_last_success_timestamp_seconds{kind} for the DukaanAiBackupStale
# alert. Compose mounts the db-backups volume read-only at
# /var/lib/dukaanai/backups and points this at its status/ directory.
BACKUP_STATUS_DIR=

################################################################################
# AUTHENTICATION
################################################################################
# With NODE_ENV=production the secret must be real: at least 32 characters and
# no template placeholder, or the API refuses to boot. Signing is HS256.
JWT_SECRET=your_jwt_secret_generate_with_openssl
# Access tokens are short-lived and carry their session id, so a logout takes
# effect at once. JWT_REFRESH_EXPIRES_IN is the idle lifetime of a refresh
# token (rotated on every refresh); SESSION_ABSOLUTE_LIFETIME caps a session
# from its login however often it is refreshed (default 12h, ASVS 3.3.2 L2,
# docs/security/ASVS_L2.md; the development and test templates use 30d).
# Durations: ms, s, m, h, d.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_ABSOLUTE_LIFETIME=12h
BCRYPT_ROUNDS=10

# Outbound email (staff invitations carry their token by email only).
# SMTP_URL is a nodemailer transport URL, e.g. smtp://user:pass@smtp.example.com:587
# or smtps://... Unset: messages are logged instead of sent, and in production
# an invitation cannot be issued until it is set.
SMTP_URL=
EMAIL_FROM=DukaanAI <no-reply@dukaanai.local>

# Google sign-in (POST /auth/google): the OAuth web client id, the same value
# as the web's GOOGLE_CLIENT_ID. The API accepts only id tokens whose audience
# is this id. Blank or a placeholder: Google sign-in is off and the route
# answers 503 GOOGLE_SIGNIN_NOT_CONFIGURED.
GOOGLE_CLIENT_ID=

# DANGER: set to true ONLY to run the app with authentication fully disabled.
# Every request then runs as a provisioned system user (system@dukaanai.local)
# and the API logs a loud warning at startup. Accepts only true/1/yes/on (or
# false/0/no/off); an unrecognized value refuses to boot. Defaults to false
# (auth enabled) when unset. Accepted only when NODE_ENV is development or
# test: with NODE_ENV=production (or unset) the API refuses to boot.
AUTH_DISABLED=false

################################################################################
# SECURITY
################################################################################
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_DURATION_MS=900000
# Per-client-IP request limits (@nestjs/throttler, counters in Redis so every
# API instance shares them). Windows are MILLISECONDS; anything under 1000 ms
# fails boot. The three general windows apply to every route; the
# AUTH_RATE_LIMIT_* limits replace them over the same windows on login,
# register, refresh, Google sign-in and invitation accept. The general values
# are sized for one shop behind one address (roadmap 9.16,
# docs/PRODUCTION_LIMITS.md: three terminals loading and billing at once
# burst to ~36 requests in a second, ~72 a minute, ~4,300 an hour;
# `load/limits-gate.mjs` measures it and requires 1.25x headroom); the AUTH
# values are the brute-force limits and stay tight.
RATE_LIMIT_SHORT_TTL_MS=10000
RATE_LIMIT_SHORT_LIMIT=60
RATE_LIMIT_MEDIUM_TTL_MS=60000
RATE_LIMIT_MEDIUM_LIMIT=200
RATE_LIMIT_LONG_TTL_MS=3600000
RATE_LIMIT_LONG_LIMIT=10000
AUTH_RATE_LIMIT_SHORT_LIMIT=5
AUTH_RATE_LIMIT_MEDIUM_LIMIT=20
AUTH_RATE_LIMIT_LONG_LIMIT=100
# Login attempts per account (any address) per medium window before 429.
AUTH_RATE_LIMIT_ACCOUNT_LIMIT=10

################################################################################
# STORAGE
################################################################################
# Local document root (billing evidence). Relative values are resolved once at
# boot against the working directory (the start scripts run from apps/api);
# NODE_ENV=production refuses a relative or placeholder root (roadmap 7.5).
STORAGE_ROOT=./data/storage
# Object storage for POST /storage/cloud/upload (S3 or any S3-compatible
# endpoint). Unset S3_BUCKET leaves the route answering "not configured";
# with a bucket, region and both keys are required (boot refuses otherwise).
# S3_PUBLIC_URL is the base of the URL returned to callers (a CDN in front).
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=your_bucket
S3_PUBLIC_URL=https://cdn.example.com

################################################################################
# AI / OCR (POST /ocr/scan-bill, roadmap 4.4)
################################################################################
# A missing or placeholder key answers 503 OCR_NOT_CONFIGURED; the key travels
# in the x-goog-api-key header, never in the URL.
GEMINI_API_KEY=your_gemini_api_key
OCR_MODEL=gemini-2.0-flash
# Upload cap (bytes, JPEG/PNG/WebP, sniffed), items kept per bill, Dice
# similarity a product match must reach (0..1), request timeout and the
# backoff between retries of the model call.
OCR_MAX_IMAGE_BYTES=10485760
OCR_MAX_ITEMS=100
OCR_FUZZY_MATCH_THRESHOLD=0.85
OCR_TIMEOUT_MS=30000
OCR_TOTAL_TIMEOUT_MS=50000
OCR_BACKOFF_MS=1000

################################################################################
# BILLING (contract docs/POS_BILLING_CONTRACT.md)
################################################################################
# Interactive transaction budget of a sale / return / repayment: sales of one
# shop queue on the gapless number lock, so a burst of checkouts must fit
# inside it (30 s covers several hundred queued checkouts; at least 1000).
BILLING_GATEWAY_TIMEOUT_MS=30000
# Time a checkout waits for a pool connection before it is rejected.
BILLING_TRANSACTION_MAX_WAIT_MS=15000
# Retry jitter after a deadlock / lock-wait rollback: base + random(0..multiplier) ms.
BILLING_JITTER_DELAY_BASE_MS=50
BILLING_JITTER_DELAY_RANDOM_MULTIPLIER=100
# --- Billing authority (defaults in src/config/domains/features/billing-feature.config.ts)
# Largest discount (percent, line / invoice / combined effective) a CASHIER may apply alone; 0..100.
BILLING_CASHIER_MAX_DISCOUNT_PERCENT=10
# Largest custom (free-priced) line amount, in rupees per line, a CASHIER may bill alone; 0 = cashiers cannot add custom lines.
BILLING_CASHIER_MAX_CUSTOM_LINE_AMOUNT=500

################################################################################
# OUTBOX & WEBHOOKS (roadmap 4.7, 4.8)
################################################################################
# List sizes of GET /events and of the delivery history per webhook.
EVENTS_RECENT_LIMIT=50
EVENTS_WEBHOOK_DELIVERY_LIMIT=5
# Rows a relay claims per run; a claim no worker finished within
# EVENTS_OUTBOX_STALE_CLAIM_MS goes back to PENDING (the reaper cron).
EVENTS_OUTBOX_PROCESSOR_BATCH_SIZE=100
EVENTS_OUTBOX_STALE_CLAIM_MS=300000
# Attempts per outbox row (first delivery included) before it is FAILED for
# POST /sales/events/retry, with an exponential backoff between attempts that
# starts at the base and never exceeds the cap.
EVENTS_OUTBOX_MAX_RETRIES=5
EVENTS_OUTBOX_RETRY_BACKOFF_MS=30000
EVENTS_OUTBOX_RETRY_BACKOFF_MAX_MS=3600000
# Webhook delivery: request timeout, whether plain http endpoints are accepted
# (development only, never in production: the URL guard also blocks private
# and loopback addresses), and the largest response body read back (logged).
EVENTS_WEBHOOK_TIMEOUT_MS=10000
EVENTS_WEBHOOK_ALLOW_HTTP=false
EVENTS_WEBHOOK_MAX_RESPONSE_BYTES=65536

################################################################################
# LIST SIZES & TUNING (every list route is also capped at 200 rows, roadmap 5.6)
################################################################################
# Purchase analytics: months in a trend, rows in the recent-orders, top-vendor
# and top-product cards.
ANALYTICS_TREND_ANALYSIS_LIMIT=12
ANALYTICS_RECENT_ORDERS_LIMIT=20
ANALYTICS_TOP_VENDORS_LIMIT=5
ANALYTICS_TOP_PRODUCTS_LIMIT=10
IMPORT_EXPORT_LIST_LIMIT=50
INVENTORY_RECENT_ADJUSTMENTS_LIMIT=100
INVENTORY_RECENT_MOVEMENTS_LIMIT=100
INVENTORY_UNRESOLVED_ALERTS_LIMIT=50
INVENTORY_LIST_LIMIT=50
# Stock reconciliation (CRON_INVENTORY_RECON): products per batch, the Redis
# lock of a run, the window of recently updated products a run inspects, and
# the largest label print run.
INVENTORY_RECON_BATCH_SIZE=1000
INVENTORY_RECON_LOCK_TTL_MS=300000
INVENTORY_RECON_LOOKBACK_MS=86400000
INVENTORY_MAX_PRINT_QUANTITY=1000
PURCHASE_DEAD_LETTER_PAGINATION_LIMIT=50
# GET /sales/events page size and the credit limit a new customer starts with.
SALES_RECENT_EVENTS_LIMIT=100
SALES_DEFAULT_CREDIT_LIMIT=5000
# Product search: fuzzy candidates scored per query, results returned,
# analytics rows read, and SearchHistory inserts recorded per shop per minute
# (searches past the budget are served but not recorded, roadmap 5.3).
SEARCH_FUZZY_CANDIDATE_LIMIT=100
SEARCH_RESULT_LIMIT=50
SEARCH_ANALYTICS_LIMIT=1000
SEARCH_HISTORY_MAX_PER_MINUTE=120
VALIDATION_DUPLICATE_SCAN_LIMIT=10

# Retention (roadmap 7.8): the nightly sweep (CRON_RETENTION_SWEEP) deletes
# refresh and password-reset tokens this many days after they expired or were
# used, DONE outbox rows this many days after they were created (FAILED rows
# stay for an operator to retry), and SearchHistory / ProductEventLog rows
# older than their window (the popular-searches card reads 7 days, so that
# window is at least 7; a replay covers only retained events). Each statement
# deletes RETENTION_BATCH_SIZE rows, at most RETENTION_MAX_BATCHES_PER_RUN
# batches per table per run; a larger backlog drains over several nights.
RETENTION_EXPIRED_TOKENS_DAYS=7
RETENTION_OUTBOX_DONE_DAYS=14
RETENTION_SEARCH_HISTORY_DAYS=90
RETENTION_PRODUCT_EVENT_LOG_DAYS=180
RETENTION_BATCH_SIZE=1000
RETENTION_MAX_BATCHES_PER_RUN=200

# Multipart uploads (roadmap 5.1): hard caps per file; uploads stream to UPLOAD_TEMP_DIR (relative to the working directory)
UPLOAD_MAX_MEDIA_BYTES=52428800
UPLOAD_MAX_IMPORT_BYTES=20971520
UPLOAD_TEMP_DIR=uploads/tmp
