################################################################################
# DUKAN AI FRONTEND ENVIRONMENT FILE
################################################################################

################################################################################
# APPLICATION
################################################################################
NODE_ENV=development
# The API as the browser reaches it: inlined into the bundle at build time and
# read again at runtime for the Content-Security-Policy connect-src.
NEXT_PUBLIC_API_URL=http://localhost:3002/api
# Runtime override of the public API URL (roadmap 9.9): a built image serves
# every environment with this set by the orchestrator; the root layout hands
# it to the browser in <meta name="dukaanai-api-url"> and the CSP reads it.
# Blank = the build-time NEXT_PUBLIC_API_URL.
API_PUBLIC_URL=
# Optional: the API as the web SERVER reaches it (sign-in, refresh), e.g. a
# private network address; defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
# Container builds only (apps/web/Dockerfile): true switches `next build` to
# the standalone output. `next start` refuses it, so leave it unset here.
NEXT_STANDALONE=
# The release this server runs, shown by GET /api/health (roadmap 9.21). The
# release workflow bakes it into the image (the version tag or sha-<commit>);
# leave it unset here.
APP_RELEASE=

################################################################################
# AUTHENTICATION
################################################################################
NEXTAUTH_SECRET=your_nextauth_secret_generate_with_openssl
NEXTAUTH_URL=http://localhost:3000

# DANGER: set to true ONLY to skip the login gate entirely (pair with the
# API's AUTH_DISABLED=true). Inlined at build time - set it before `next build`.
# Defaults to false (login required) when unset.
NEXT_PUBLIC_AUTH_DISABLED=false

################################################################################
# OAUTH
################################################################################
# The provider is registered only with real values (a placeholder leaves
# Google sign-in off), and the "Continue with Google" button on the login and
# register pages follows the same rule at run time (<meta
# name="dukaanai-google-signin">). The API needs the same GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
